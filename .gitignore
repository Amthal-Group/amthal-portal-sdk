# ==========================================================================
# Amthal Portal SDK — monorepo .gitignore (Node + iOS + Android + Expo)
# ==========================================================================

# --- Node / JS ---
node_modules/
dist/
build/
lib/
coverage/
*.tsbuildinfo
.npm/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Expo / React Native ---
.expo/
.expo-shared/
*.jsbundle
web-build/

# SDK Swift sources copied into the Expo module pod at `pod install` time
# (see wrappers/expo/ios/AmthalPortalNative.podspec → prepare_command).
**/ios/Generated/

# --- iOS / Swift Package Manager / CocoaPods / Xcode ---
.build/
**/.build/
Package.resolved
Pods/
*.xcworkspace/xcuserdata/
**/xcuserdata/
DerivedData/
*.pbxuser
*.xcuserstate
.swiftpm/
*.ipa
*.dSYM
*.dSYM.zip

# --- Android / Gradle ---
.gradle/
android/build/
**/android/.cxx/
local.properties
*.apk
*.aab
*.keystore
!debug.keystore
captures/
.externalNativeBuild/

# --- Editors / OS ---
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
