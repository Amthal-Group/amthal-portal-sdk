{
  "name": "@amthal-group/portal-expo",
  "version": "1.0.0",
  "description": "Amthal Portal Embed SDK for Expo/React Native — presents the native Client Portal SDK (WKWebView) in a device-native modal sheet, bridged from JS",
  "license": "MIT",
  "author": "Amthal Group <dev@amthalgroup.com>",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "ios",
    "expo-module.config.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepack": "npm run vendor:ios",
    "vendor:ios": "rm -rf ios/Generated && mkdir -p ios/Generated && cp -R ../../ios/Sources/AmthalPortal/. ios/Generated/"
  },
  "keywords": [
    "amthal",
    "portal",
    "expo",
    "expo-module",
    "react-native",
    "sheet",
    "webview"
  ],
  "peerDependencies": {
    "expo": "*",
    "expo-modules-core": "*",
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "dependencies": {
    "@amthal-group/portal-bridge": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "expo": "55.0.31",
    "expo-modules-core": "55.0.26",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amthal-Group/amthal-portal-sdk.git"
  },
  "homepage": "https://amthal.erpamthal.com/portal-sdk-docs/",
  "bugs": {
    "url": "https://github.com/Amthal-Group/amthal-portal-sdk/issues"
  }
}
